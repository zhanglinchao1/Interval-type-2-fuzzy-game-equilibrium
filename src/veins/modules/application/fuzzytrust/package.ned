package org.car2x.veins.modules.application.fuzzytrust;

//
// FuzzyTrust 应用包
//
// 此包包含用于实现车载网络中综合信任评估系统的模块，
// 该系统使用模糊逻辑、博弈论和强化学习技术。
//
// 主要组件：
// - FuzzyTrustApp：主应用模块
// - FuzzyTrust：核心信任评估引擎
// - ChannelQuality：信道质量评估
// - ResourceManager：资源分配和管理
// - GameManager：基于博弈论的决策
// - OWARLAgent：乐观加权平均奖励学习代理
// - FuzzyInferenceEngine：模糊逻辑推理系统
//